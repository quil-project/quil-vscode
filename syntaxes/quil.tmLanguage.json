{
  "name": "PiNum",
  "scopeName": "source.pn",
  "patterns": [
    {
      "name": "comment.line.hashtag.pn",
      "match": "#.*$"
    },
    {
      "name": "keyword.control.directive.pn",
      "match": "@\\w+"
    },
    {
      "name": "keyword.control.pn",
      "match": "\\b(if|else|while|for|break|continue|return|fn)\\b"
    },
    {
      "name": "support.function.builtin.pn",
      "match": "\\b(print|println|read)\\b"
    },
    {
      "name": "storage.type.vec.pn",
      "begin": "\\b(vec)(<)",
      "beginCaptures": {
        "1": { "name": "storage.type.pn" },
        "2": { "name": "punctuation.definition.typeparameters.begin.pn" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.typeparameters.end.pn" }
      },
      "patterns": [
        {
          "name": "storage.type.pn",
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|char|string|bool)\\b"
        }
      ]
    },
    {
      "name": "storage.type.pn",
      "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|char|string|bool|vec)\\b"
    },
    {
      "name": "constant.language.pn",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "constant.numeric.pn",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "keyword.operator.ternary.pn",
      "match": "\\?"
    },
    {
      "name": "entity.name.function.vec.method.pn",
      "match": "\\b(append|size)\\b"
    },
    {
      "name": "string.quoted.double.pn",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.pn",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.pn",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.pn",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.operator.increment.pn",
      "match": "\\+\\+|--"
    },
    {
      "name": "keyword.operator.assignment.compound.pn",
      "match": "\\+=|-=|\\*=|/=|%="
    },
    {
      "name": "keyword.operator.comparison.pn",
      "match": "==|!=|<=|>=|&&|\\|\\|"
    },
    {
      "name": "keyword.operator.pn",
      "match": "[+\\-\\*/%=<>!&\\|?~:]"
    }
  ]
}
