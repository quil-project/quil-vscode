{
        "name": "Quil",
        "scopeName": "source.quil",
        "patterns": [
                {
                        "name": "comment.line.double-slash.quil",
                        "match": "//.*$"
                },
                {
                        "name": "keyword.control.directive.quil",
                        "match": "@\\w+"
                },
                {
                        "name": "keyword.control.quil",
                        "match": "\\b(if|else|while|for|break|continue|return)\\b"
                },
                {
                        "name": "keyword.declaration.quil",
                        "match": "\\b(fn|import)\\b"
                },
                {
                        "name": "storage.modifier.quil",
                        "match": "\\b(scope|struct|public|extern)\\b"
                },
                {
                        "name": "entity.name.function.quil",
                        "match": "(?<=\\bfn\\s+)\\w+"
                },
                {
                        "name": "entity.name.namespace.quil",
                        "match": "\\b\\w+(?=::)"
                },
                {
                        "name": "entity.name.function.quil",
                        "match": "\\b\\w+(?=\\s*\\()"
                },
                {
                        "name": "storage.type.quil",
                        "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|char|string|bool|void)\\b"
                },
                {
                        "name": "constant.language.quil",
                        "match": "\\b(true|false)\\b"
                },
                {
                        "name": "constant.numeric.quil",
                        "match": "\\b\\d+(\\.\\d+)?\\b"
                },
                {
                        "name": "keyword.operator.ternary.quil",
                        "match": "\\?"
                },
                {
                        "name": "string.quoted.double.quil",
                        "begin": "\"",
                        "end": "\"",
                        "patterns": [
                                {
                                        "name": "constant.character.escape.quil",
                                        "match": "\\\\."
                                }
                        ]
                },
                {
                        "name": "string.quoted.single.quil",
                        "begin": "'",
                        "end": "'",
                        "patterns": [
                                {
                                        "name": "constant.character.escape.quil",
                                        "match": "\\\\."
                                }
                        ]
                },
                {
                        "name": "keyword.operator.arrow.quil",
                        "match": "->|::"
                },
                {
                        "name": "keyword.operator.increment.quil",
                        "match": "\\+\\+|--"
                },
                {
                        "name": "keyword.operator.assignment.compound.quil",
                        "match": "\\+=|-=|\\*=|/=|%="
                },
                {
                        "name": "keyword.operator.comparison.quil",
                        "match": "==|!=|<=|>=|&&|\\|\\|"
                },
                {
                        "name": "keyword.operator.quil",
                        "match": "[+\\-\\*/%=<>!&\\|?~:]"
                }
        ]
}
